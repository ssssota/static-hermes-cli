+/// Return the root of the prebuilt toolchain containing this executable.
+///
+/// The release layout is:
+///   <root>/bin/shermes
+///   <root>/include/...
+///   <root>/lib/...
+///
+/// Resolve symlinks before walking up from bin so that users can safely put a
+/// symlink to shermes on PATH. SHERMES_TOOLCHAIN_ROOT is primarily useful to
+/// embedders and for diagnostics.
+static std::string getToolchainRoot() {
+  if (const char *overrideRoot = ::getenv("SHERMES_TOOLCHAIN_ROOT")) {
+    if (*overrideRoot)
+      return overrideRoot;
+  }
+
+  std::string executable =
+      llvh::sys::fs::getMainExecutable(nullptr, nullptr);
+  if (executable.empty())
+    return {};
+
+  llvh::SmallString<256> resolved;
+  if (llvh::sys::fs::real_path(executable, resolved))
+    resolved = executable;
+
+  llvh::sys::path::remove_filename(resolved);
+  llvh::sys::path::remove_filename(resolved);
+  return resolved.str().str();
+}
+
+static void populateToolchainPaths(CCCfg &cfg) {
+  std::string root = getToolchainRoot();
+  if (root.empty())
+    return;
+
+  llvh::SmallString<256> configInclude(root);
+  llvh::sys::path::append(configInclude, "include", "config");
+  cfg.hermesIncludePath.push_back(configInclude.str().str());
+
+  llvh::SmallString<256> include(root);
+  llvh::sys::path::append(include, "include");
+  cfg.hermesIncludePath.push_back(include.str().str());
+
+  llvh::SmallString<256> lib(root);
+  llvh::sys::path::append(lib, "lib");
+  cfg.hermesLibPath.push_back(lib.str().str());
+}
+
